{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ADR Studio",
  "version": "1.2.1",
  "identifier": "io.github.hmug12.adr-studio",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "licenseFile": "./resources/license.rtf",
    "windows": {
      "nsis": {
        "languages": ["SimpChinese"]
      }
    }
  }
}
